{
  "name": "voxlingua107",
  "version": "1.0.0",
  "description": "Spoken language identification (107 languages) for Node.js, Bun and the browser. SpeechBrain's VoxLingua107 ECAPA-TDNN on ONNX Runtime, no Python.",
  "keywords": [
    "language-identification",
    "language-detection",
    "spoken-language",
    "speech",
    "audio",
    "voxlingua107",
    "speechbrain",
    "ecapa-tdnn",
    "onnx",
    "bun",
    "browser",
    "webassembly"
  ],
  "license": "Apache-2.0",
  "author": "Pol Vallverdu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polvallverdu/voxlingua107.git"
  },
  "homepage": "https://github.com/polvallverdu/voxlingua107#readme",
  "bugs": "https://github.com/polvallverdu/voxlingua107/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "bin": {
    "voxlingua107": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "bun test",
    "test:node": "bun run build && node test/node-smoke.mjs",
    "prepublishOnly": "bun run build",
    "test:browser": "bun test/browser/run.ts"
  },
  "dependencies": {
    "onnxruntime-node": "^1.30.0"
  },
  "peerDependencies": {
    "onnxruntime-web": "^1.30.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "onnxruntime-web": "^1.30.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
